// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai",
      "model": "gpt-5.5"
    },
  },
  "edit_predictions": {
    "provider": "copilot",
    "copilot": {
      "enterprise_uri": "https://bmw.ghe.com"
    }
  },
  "icon_theme": "VSCode Icons for Zed (Dark NestJS)",
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 22.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "GitHub Dark Dimmed"
  }
}
